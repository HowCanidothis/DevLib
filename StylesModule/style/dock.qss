DockArea {
    qproperty-stripThickness: 0;
    qproperty-controlOffset: 4;
    qproperty-moveColor: @ctext.1;
    qproperty-makeRoomColor: @c.warning;
    qproperty-insertLineColor: @c.warning;
    qproperty-mergeColor: @c.success;
    qproperty-previewFillAlpha: 70;
    qproperty-controlColor: @cbg.2;
    qproperty-controlHoverColor: @cbg.hover;
    qproperty-controlGlyphColor: @ctext.label;
    qproperty-controlGlyphHoverColor: @ctext.active;
    qproperty-controlShadowColor: @cbg.alt;
    qproperty-cellSpacing: 8;
    qproperty-gridTopMargin: 0;
    qproperty-borderHandleWidth: 6;
    qproperty-containerRadius: @cRadius.1n;
    qproperty-containerBorderColor: transparent;
    qproperty-canvasColor: @cbg.1;
}

QWidget#DockStrip {
    background: transparent;
}

DockWidgetsContainer > QStackedWidget {
    background: @cbg.2;
    border-radius: @cRadius.1;
}

DockWidgetsContainer[a_strip="true"] > QStackedWidget {
    border-top-left-radius: 0px;
}

DockTabBar {
    background: transparent;
}

DockTabBar::tab:top {
    border-top-left-radius: @cRadius.1;
    border-top-right-radius: @cRadius.1;
}

DockTabBar::tab:top:!selected {
    background: @cbg.1;
}

DockTabBar::tab:top:selected {
    background: @cbg.2;
}

DockFloatingWindow {
    background: @cbg.2;
}

QFrame#DockTitleBar {
    background: @cbg.1;
}

QToolButton#DockTitleBarClose {
    qproperty-icon: url(@cPath/close.svg);
    background: transparent;
    border: none;
}

QToolButton#DockTitleBarClose:hover {
    background: @c.error;
}